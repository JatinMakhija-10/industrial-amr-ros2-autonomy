<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_robot">

  <!-- ========================================== -->
  <!-- Include Gazebo Plugins & ros2_control Tags -->
  <!-- ========================================== -->
  <xacro:include filename="$(find amr_robot)/urdf/amr_gazebo.xacro" />
  <xacro:include filename="$(find amr_robot)/urdf/ros2_control.xacro" />

  <!-- ========================================== -->
  <!-- Robot Physical Dimensions & Parameters     -->
  <!-- ========================================== -->
  <xacro:property name="chassis_length" value="0.318" />
  <xacro:property name="chassis_width"  value="0.3475" />
  <xacro:property name="chassis_height" value="0.180" />
  <xacro:property name="chassis_mass"   value="12.5" />

  <xacro:property name="wheel_radius"   value="0.05035" />
  <xacro:property name="wheel_width"    value="0.040" />
  <xacro:property name="wheel_mass"     value="1.2" />
  <xacro:property name="track_width"    value="0.280" />

  <xacro:property name="caster_radius"  value="0.025" />
  <xacro:property name="caster_mass"    value="0.3" />
  <xacro:property name="caster_offset_x" value="0.120" />

  <xacro:property name="lidar_radius"   value="0.035" />
  <xacro:property name="lidar_height"   value="0.040" />
  <xacro:property name="lidar_mass"     value="0.22" />

  <!-- Material Definitions -->
  <material name="industrial_dark">
    <color rgba="0.15 0.15 0.18 1.0" />
  </material>
  <material name="aluminum_gray">
    <color rgba="0.75 0.76 0.78 1.0" />
  </material>
  <material name="accent_blue">
    <color rgba="0.0 0.45 0.85 1.0" />
  </material>
  <material name="rubber_black">
    <color rgba="0.05 0.05 0.05 1.0" />
  </material>
  <material name="sensor_red">
    <color rgba="0.9 0.1 0.1 1.0" />
  </material>

  <!-- ========================================== -->
  <!-- Inertial Calculation Macros               -->
  <!-- ========================================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}" />
      <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (x*x + z*z)}" iyz="0.0"
               izz="${(m/12) * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}" />
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}" />
      <inertia ixx="${(2/5) * m * r * r}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * m * r * r}" iyz="0.0"
               izz="${(2/5) * m * r * r}" />
    </inertial>
  </xacro:macro>

  <!-- ========================================== -->
  <!-- Root Coordinate Frame: base_footprint     -->
  <!-- ========================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ========================================== -->
  <!-- Primary Structural Chassis: base_link      -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="aluminum_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}" />
  </link>

  <!-- Top Mounting Plate Accent -->
  <link name="top_plate_link">
    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length * 0.95} ${chassis_width * 0.95} 0.006" />
      </geometry>
      <material name="industrial_dark" />
    </visual>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link" />
    <child link="top_plate_link" />
    <origin xyz="0 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ========================================== -->
  <!-- Drive Wheels (Differential Drive)          -->
  <!-- ========================================== -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_reflect * track_width / 2} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1" />
  <xacro:drive_wheel prefix="right" y_reflect="-1" />

  <!-- ========================================== -->
  <!-- Passive Casters (Front & Rear Stability)   -->
  <!-- ========================================== -->
  <xacro:macro name="caster_wheel" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
        <material name="industrial_dark" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}" />
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="front" x_offset="${caster_offset_x}" />
  <xacro:caster_wheel prefix="rear"  x_offset="${-caster_offset_x}" />

  <!-- ========================================== -->
  <!-- RPLiDAR A1M8 2D 360° LiDAR Sensor         -->
  <!-- Total Height = 0.05035 + 0.180 + 0.040 = 0.27035m (~271 mm) -->
  <!-- ========================================== -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
      <material name="accent_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}" />
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}" />
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="0.06 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ========================================== -->
  <!-- 9-DOF IMU Sensor (BNO055 / BNO085)        -->
  <!-- ========================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.025 0.025 0.005" />
      </geometry>
      <material name="sensor_red" />
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.025 0.005" />
      </geometry>
    </collision>
    <xacro:box_inertia m="0.015" x="0.025" y="0.025" z="0.005" />
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

</robot>
