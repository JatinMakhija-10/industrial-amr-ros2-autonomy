<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="industrial_warehouse">
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 20x20m Ground Plane -->
    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Perimeter Boundary Walls (20m x 20m x 3m) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.3 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20 0.3 3</size></box></geometry>
        <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
      </link>
    </model>
    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.3 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20 0.3 3</size></box></geometry>
        <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
      </link>
    </model>
    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 20 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 20 3</size></box></geometry>
        <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
      </link>
    </model>
    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 20 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 20 3</size></box></geometry>
        <material><ambient>0.3 0.3 0.35 1</ambient></material></visual>
      </link>
    </model>

    <!-- Structural Support Pillars (3 Columns) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
        <material><ambient>0.6 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
        <material><ambient>0.6 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
        <material><ambient>0.6 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- 12 Heavy-Duty Storage Racks Arranged in 4 Columns of 3 -->
    <!-- Column 1 (x = -6m) -->
    <model name="rack_c1_r1"><static>true</static><pose>-6 6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c1_r2"><static>true</static><pose>-6 0 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c1_r3"><static>true</static><pose>-6 -6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>

    <!-- Column 2 (x = -2m) -->
    <model name="rack_c2_r1"><static>true</static><pose>-2 6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c2_r2"><static>true</static><pose>-2 0 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c2_r3"><static>true</static><pose>-2 -6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>

    <!-- Column 3 (x = 2m) -->
    <model name="rack_c3_r1"><static>true</static><pose>2 6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c3_r2"><static>true</static><pose>2 0 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c3_r3"><static>true</static><pose>2 -6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>

    <!-- Column 4 (x = 6m) -->
    <model name="rack_c4_r1"><static>true</static><pose>6 6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c4_r2"><static>true</static><pose>6 0 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>
    <model name="rack_c4_r3"><static>true</static><pose>6 -6 1.2 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.2 3.0 2.4</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 3.0 2.4</size></box></geometry><material><ambient>0.2 0.4 0.7 1</ambient></material></visual></link></model>

  </world>
</sdf>
